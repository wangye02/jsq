<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="#16213E"
    android:layout_margin="6dp"
    android:padding="14dp"
    android:elevation="4dp">

    <!-- 第一行：标签 + 按钮 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <TextView
            android:id="@+id/timer_label"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="计时器"
            android:textColor="#FFFFFF"
            android:textSize="16sp"
            android:textStyle="bold" />

        <ImageButton
            android:id="@+id/btn_start_pause"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:src="@android:drawable/ic_media_play"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="开始/暂停" />

        <ImageButton
            android:id="@+id/btn_reset"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:src="@android:drawable/ic_menu_revert"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="重置" />

        <ImageButton
            android:id="@+id/btn_ringtone"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:src="@android:drawable/ic_lock_silent_mode_off"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="铃声" />

        <ImageButton
            android:id="@+id/btn_delete"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:src="@android:drawable/ic_delete"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="删除" />
    </LinearLayout>

    <!-- 第二行：时间显示 -->
    <TextView
        android:id="@+id/timer_time"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="00:00"
        android:textColor="#E94560"
        android:textSize="36sp"
        android:textStyle="bold"
        android:gravity="center"
        android:paddingTop="8dp"
        android:paddingBottom="4dp"
        android:fontFamily="monospace" />

    <!-- 第三行：总时长 -->
    <TextView
        android:id="@+id/timer_total"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="总时长: 0s"
        android:textColor="#888888"
        android:textSize="12sp"
        android:gravity="center" />

    <!-- 第四行：音量控制 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingTop="8dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="音量"
            android:textColor="#888888"
            android:textSize="12sp"
            android:paddingEnd="8dp" />

        <SeekBar
            android:id="@+id/volume_bar"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:max="100"
            android:progress="80"
            android:thumbTint="#E94560"
            android:progressTint="#E94560" />
    </LinearLayout>
</LinearLayout>
